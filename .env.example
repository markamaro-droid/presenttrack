# Server only. Copy to .env.local; never put secrets in js/config.js.
# Tracy's active browser-voice mode uses Groq. No OpenAI credits are required.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Optional fallback after Groq. Also works alone when GROQ_API_KEY is empty.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional legacy OpenAI endpoints:
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
# Use the SAME project URL and publishable key as js/config.js.
SUPABASE_URL=https://wzmsyordhvfxinlpfbhc.supabase.co
SUPABASE_ANON_KEY=
# Tracy's quota function uses the authenticated user's JWT; no service_role key needed.

# Stage 1 task-router/benchmark settings. Not yet used by the live assessment route.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-transcribe
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3
GROQ_TIMING_MODEL=whisper-large-v3
GEMINI_VERBATIM_MODEL=gemini-3.5-flash-lite
DEEPSEEK_ANALYSIS_MODEL=deepseek-flash
DEEPSEEK_PROOFREADING_MODEL=deepseek-flash
GEMINI_LAYOUT_MODEL=gemini-3.5-flash-lite
OPENAI_LAYOUT_MODEL=gpt-4o-mini
TASK_TIMEOUT_MS=12000
# Set true if these provider projects have paid billing enabled.
GEMINI_PAID=false
GROQ_PAID=false
SPEECH_PAUSE_THRESHOLD_SEC=2
SPEECH_IDEAL_WPM_MIN=110
SPEECH_IDEAL_WPM_MAX=160
SPEECH_WEIGHT_PACE=0.4
SPEECH_WEIGHT_PAUSES=0.3
SPEECH_WEIGHT_FILLERS=0.3
# Optional absolute FFmpeg executable path for the local comparison script.
FFMPEG_PATH=
