# Server only. Copy to .env.local; never put secrets in js/config.js.
# Tracy's active browser-voice mode uses Groq. No OpenAI credits are required.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Optional fallback after Groq. Also works alone when GROQ_API_KEY is empty.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional legacy OpenAI endpoints:
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
# Use the SAME project URL and publishable key as js/config.js.
SUPABASE_URL=https://wzmsyordhvfxinlpfbhc.supabase.co
SUPABASE_ANON_KEY=
# Tracy's quota function uses the authenticated user's JWT; no service_role key needed.
