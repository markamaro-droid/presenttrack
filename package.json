{
  "name": "presenttrack",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local tools/dev.mjs",
    "build": "node tools/build.mjs",
    "diagnose:ai": "node --env-file=.env.local tools/diagnose-ai.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:assessment": "node --test supabase/tests/classify.test.js supabase/tests/feedback.test.js supabase/tests/metrics.test.js supabase/tests/quality.test.js"
  },
  "dependencies": {
    "fast-xml-parser": "5.12.1",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.5.438",
    "yauzl": "3.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.16"
  }
}
