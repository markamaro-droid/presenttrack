{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    { "source": "/", "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }] },
    { "source": "/index.html", "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }] },
    { "source": "/:file(.*\\.[a-f0-9]{16}\\.js)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/:file(.*\\.[a-f0-9]{16}\\.css)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/js/config.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/api/:path*", "headers": [{ "key": "Cache-Control", "value": "private, no-store" }] }
  ],
  "functions": {
    "api/admin.js": { "maxDuration": 60 },
    "api/learning.js": { "maxDuration": 60, "includeFiles": "node_modules/pdfjs-dist/legacy/build/pdf.worker.mjs" },
    "api/cloudconvert-webhook.js": { "maxDuration": 60 },
    "api/presentation-maintenance.js": { "maxDuration": 60 },
    "api/presentations.js": {
      "maxDuration": 60
    },
    "api/chat.js": {
      "maxDuration": 60
    },
    "api/voice.js": {
      "maxDuration": 60
    },
    "api/coach.js": {
      "maxDuration": 60
    },
    "api/practice.js": {
      "maxDuration": 120
    },
    "api/speech.js": {
      "maxDuration": 60
    }
  },
  "crons": [{ "path": "/api/presentation-maintenance", "schedule": "15 0 * * *" }]
}
