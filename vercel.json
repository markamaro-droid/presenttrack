{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    { "source": "/", "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }] },
    { "source": "/index.html", "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }] },
    { "source": "/:file(.*\\.[a-f0-9]{16}\\.(js|css))", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/js/config.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/api/:path*", "headers": [{ "key": "Cache-Control", "value": "private, no-store" }] }
  ],
  "functions": {
    "api/chat.js": {
      "maxDuration": 60
    },
    "api/voice.js": {
      "maxDuration": 60
    },
    "api/coach.js": {
      "maxDuration": 60
    },
    "api/practice.js": {
      "maxDuration": 120
    },
    "api/speech.js": {
      "maxDuration": 60
    }
  }
}
